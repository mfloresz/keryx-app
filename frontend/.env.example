# ==========================================
# Keryx - Cloud Mode with Supabase
# ==========================================
#
# This file is for running the app in:
#   VITE_DEPLOY_MODE=cloud
#
# In cloud mode there are 2 kinds of env vars:
#
# 1. Frontend / browser variables
#    These MUST start with VITE_ because Vite exposes them to the client.
#
# 2. Backend / server variables
#    These MUST NOT start with VITE_ because they are private.
#
# Important:
# - VITE_* vars are visible to the frontend bundle.
# - Never put secrets in VITE_* vars.
# - SUPABASE_SERVICE_ROLE_KEY must stay server-only.


# ==========================================
# Shared app config
# ==========================================
VITE_APP_NAME=Keryx
VITE_DEPLOY_MODE=cloud
VITE_ENABLE_AUTH=true
VITE_ENABLE_LOCAL_KEYS=false
VITE_ENABLE_OPFS=false
VITE_ENABLE_ADMIN=true


# ==========================================
# Frontend / browser
# ==========================================
# These are used in the browser for user login.
# Safe to expose to the frontend:
# - Supabase project URL
# - Supabase anon/public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key


# ==========================================
# Backend / server
# ==========================================
# These are used by the server-side API layer.
# In local dev, your local Vite server uses them.
# In production, Vercel should use them.
SUPABASE_URL=https://your-project.supabase.co
# Public key used server-side only to validate bearer tokens with Supabase Auth fallback.
# It can be the same value as VITE_SUPABASE_ANON_KEY.
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# ==========================================
# JWT verification on the backend
# ==========================================
# Supabase automatically creates the user's session JWT.
# Your backend verifies that JWT on incoming requests.
#
# Use ONE of these:
#
# Option A: recommended
# Public JWKS endpoint used to verify Supabase JWTs
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
#
# Option B: legacy / alternative
# If you prefer using the JWT secret directly, set this and you can leave JWKS empty
SUPABASE_JWT_SECRET=


# ==========================================
# AI provider keys used by the backend
# ==========================================
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
OPENCODE_API_KEY=


# ==========================================
# App URLs / invitations
# ==========================================
# Base URL used to generate invitation links.
# Local example:
APP_BASE_URL=http://localhost:5174
INVITATION_EXPIRY_HOURS=72


# ==========================================
# Bootstrap first admin user
# ==========================================
# Optional but very useful the first time.
# If there are no users yet, the backend will create this first admin automatically.
#
# After the first admin exists, you can remove these if you want.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-please


# ==========================================
# Database schema setup
# ==========================================
# Before using cloud mode for the first time,
# run this SQL in the Supabase SQL Editor:
#
#   docs/supabase-cloud-schema.sql
