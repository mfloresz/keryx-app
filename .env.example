# Public app URL used to build invitation links in the admin panel
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional base path if you deploy the app under a sub-path
NEXT_PUBLIC_BASE_PATH=

# PocketBase server URL
POCKETBASE_URL=http://127.0.0.1:8090

# PocketBase superuser credentials (for server-side admin operations and init script)
POCKETBASE_SUPERUSER_EMAIL=admin@example.com
POCKETBASE_SUPERUSER_PASSWORD=change-me-superuser-password

# Optional: first application admin created in the auth collection by `pnpm pb:init`
POCKETBASE_INITIAL_APP_ADMIN_EMAIL=owner@example.com
POCKETBASE_INITIAL_APP_ADMIN_PASSWORD=change-me-app-admin-password

# Active Vercel AI Gateway credentials
# On Vercel this can often be omitted if OIDC-backed gateway auth is configured.
AI_GATEWAY_API_KEY=

# OpenCode GO OpenAI-compatible endpoint
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# Optional resumable stream persistence
REDIS_URL=

# Optional file upload support via Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Optional flags
IS_DEMO=0
